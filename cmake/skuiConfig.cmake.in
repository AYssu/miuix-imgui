@PACKAGE_INIT@

if(NOT skui_FIND_COMPONENTS)
    set(skui_FIND_COMPONENTS ui navigation)
endif()
foreach(component IN LISTS skui_FIND_COMPONENTS)
    if(NOT component STREQUAL "ui" AND NOT component STREQUAL "navigation")
        set(skui_FOUND FALSE)
        set(skui_NOT_FOUND_MESSAGE "Unknown skui component: ${component}; available: ui, navigation")
        return()
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/skuiNavigationTargets.cmake")
set(skui_navigation_FOUND TRUE)

if("ui" IN_LIST skui_FIND_COMPONENTS)
    if("@SKUI_IMGUI_TARGET@" STREQUAL "")
        if("@SKUI_PACKAGE_FREETYPE@")
            include(CMakeFindDependencyMacro)
            find_dependency(Freetype 2.13.3)
        endif()
    else()
        # The installing host owns ImGui. The consuming host must provide a
        # compatible target too; never silently introduce a second ImGui.
        if(NOT SKUI_IMGUI_TARGET)
            set(SKUI_IMGUI_TARGET "@SKUI_IMGUI_TARGET@")
        endif()
        if(NOT TARGET "${SKUI_IMGUI_TARGET}")
            set(skui_FOUND FALSE)
            set(skui_NOT_FOUND_MESSAGE "This skui package uses host ImGui. Define a compatible ImGui 1.93.0 target before find_package and set SKUI_IMGUI_TARGET to its name.")
            return()
        endif()
        if(NOT TARGET skui::imgui-host)
            add_library(skui::imgui-host INTERFACE IMPORTED)
            set_property(TARGET skui::imgui-host PROPERTY INTERFACE_LINK_LIBRARIES "${SKUI_IMGUI_TARGET}")
        endif()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/skuiTargets.cmake")
    set(skui_ui_FOUND TRUE)
endif()
check_required_components(skui)
